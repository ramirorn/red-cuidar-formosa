# Los scripts se ejecutan dentro de contenedores Linux: siempre con fin de línea LF, aunque el
# repositorio se clone en Windows (con CRLF, bash falla y PostgreSQL queda sin los roles).
*.sh text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
