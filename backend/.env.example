# Variables del docker-compose de desarrollo. Copiar a backend/.env y completar.
# Cada clave y secreto debe ser distinto; los secretos, de al menos 32 caracteres.

# --- PostgreSQL / PostGIS ---
POSTGRES_PASSWORD="Tu clave del superusuario de PostgreSQL"
DB_API_PASSWORD="Tu clave para rol_api"
DB_MOTOR_PASSWORD="Tu clave para rol_motor"
DB_N8N_PASSWORD="Tu clave para rol_n8n"

# --- Redis ---
REDIS_PASSWORD="Tu clave de Redis"

# --- API Node ---
JWT_SECRET="Tu secreto para los tokens institucionales"
JWT_SECRET_SESIONES="Tu secreto para las sesiones anónimas"
CLAVE_SERVICIO_INTERNO="Tu clave compartida entre API, motor y n8n"
CORS_ORIGENES="http://localhost:5173"
SEMILLA_ADMIN_EMAIL="admin@redcuidar.local"
SEMILLA_ADMIN_PASSWORD="Tu clave de al menos 12 caracteres"
SEMILLA_MANZANAS_EJEMPLO=true

# --- Web Push (generar con: cd api && npm run generar-vapid) ---
VAPID_CLAVE_PUBLICA=""
VAPID_CLAVE_PRIVADA=""
VAPID_CONTACTO="mailto:salud@redcuidar.local"

# --- n8n ---
N8N_ENCRYPTION_KEY="Tu clave de cifrado de credenciales de n8n"
# API de clima (Open-Meteo, sin clave)
URL_API_CLIMA="https://api.open-meteo.com"

# --- Chat "IA Mosquito" ---
# Production URL del flujo de chat en n8n. Vacío: se usa el flujo incluido (http://n8n:5678/webhook/chat-mosquito).
# Si el flujo está en el n8n de este docker-compose: http://n8n:5678/webhook/<ruta> (NO uses localhost ni host.docker.internal).
# Si tu n8n corre fuera de Docker en esta compu: http://host.docker.internal:5678/webhook/<ruta>
# Si el flujo no responde, contesta el asistente básico de la API (preguntas frecuentes y signos de alarma).
URL_CHAT_ORQUESTADOR=""

# --- Ollama ---
# Por defecto Ollama corre en la computadora anfitriona, fuera de Docker.
# Con el perfil "ollama-contenedor", cambiar a http://ollama:11434
URL_OLLAMA="http://host.docker.internal:11434"
MODELO_OLLAMA="nemotron-3-nano:4b"
