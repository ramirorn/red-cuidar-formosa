        "method": "POST",
        "url": "={{ $env.URL_API }}/interno/notificaciones/lluvia",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ localidadId: $('Lluvia últimas 24 h').item.json.localidadId, precipitacionMm: $('Lluvia últimas 24 h').item.json.precipitacionMm }) }}",
        "options": {
          "timeout": 30000
        }
      },
