      "parameters": {
        "operation": "executeQuery",
        "query": "-- Sus suscripciones y triajes se borran en cascada; los reportes se conservan sin la sesión.\nWITH borradas AS (\n  DELETE FROM \"sesionAnonima\"\n  WHERE \"ultimaActividadEn\" < (now() AT TIME ZONE 'UTC') - interval '30 days'\n  RETURNING 1\n)\nSELECT COUNT(*)::int AS \"sesionesBorradas\" FROM borradas",
