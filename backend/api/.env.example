# Puerto para el servidor Express
PORT=3000
NODE_ENV=development

# URL de conexión para Prisma (usuario:password@host:puerto/base_de_datos)
DATABASE_URL="postgresql://rol_api:Tu_clave@localhost:5433/red_cuidar"

# Secretos para JWT (mínimo 32 caracteres cada uno, distintos entre sí)
JWT_SECRET="Tu secreto para los tokens institucionales"
JWT_SECRET_SESIONES="Tu secreto para las sesiones anónimas"

# Clave compartida con n8n y el motor predictivo (mínimo 32 caracteres)
CLAVE_SERVICIO_INTERNO="Tu clave de servicio interno"

# Orígenes permitidos por CORS, separados por coma (la PWA y el dashboard)
CORS_ORIGENES="http://localhost:5173"

# Cantidad de proxies de confianza delante de la API (0 si no hay ninguno)
CONFIAR_PROXY=0

# Directorio donde se guardan las fotos de evidencia
DIR_EVIDENCIAS="./almacenamiento/evidencias"

# Redis (caché del mapa de calor) y motor predictivo
REDIS_URL="redis://localhost:6379"
URL_MOTOR_PREDICTIVO="http://localhost:8000"

# Webhook del chat "IA Mosquito" en n8n
URL_CHAT_ORQUESTADOR="http://localhost:5678/webhook/chat-mosquito"

# Claves VAPID de Web Push (generarlas con: npm run generar-vapid)
VAPID_CLAVE_PUBLICA=""
VAPID_CLAVE_PRIVADA=""
VAPID_CONTACTO="mailto:salud@redcuidar.local"

# Semilla: primer administrador y grilla sintética de manzanas para desarrollo
SEMILLA_ADMIN_EMAIL="admin@redcuidar.local"
SEMILLA_ADMIN_PASSWORD="Tu clave de al menos 12 caracteres"
SEMILLA_MANZANAS_EJEMPLO=true
